# =============================================================================
# Fluently Frontend — copy to .env and fill in real values. Never commit .env.
# Only VITE_* variables are exposed to the browser. Do NOT put secrets here.
# =============================================================================

# Backend API URL (local dev)
VITE_API_URL=http://localhost:8000
# Production example (set at build time):
# VITE_API_URL=https://api.fluently.yourdomain.com

# Supabase public credentials (Project Settings → API)
# Must match SUPABASE_URL / SUPABASE_ANON_KEY on the backend
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
