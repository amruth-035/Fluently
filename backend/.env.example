# =============================================================================
# Fluently Backend — copy to .env and fill in real values. Never commit .env.
# =============================================================================

# --- Database (Supabase → Project Settings → Database) ---
# Use the Session pooler URI if direct db.*.supabase.co fails (common on Windows ARM).
# URL-encode special characters in the password (# → %23, & → %26).
DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@aws-0-us-west-2.pooler.supabase.com:5432/postgres

# --- Supabase (Project Settings → API) ---
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# Server only — never expose to the frontend or commit to git
SUPABASE_SERVICE_KEY=your-service-role-key
SUPABASE_STORAGE_BUCKET=recordings
# Legacy JWT secret (API → JWT Settings → Legacy JWT Secret)
SUPABASE_JWT_SECRET=your-jwt-secret

# --- OpenAI (https://platform.openai.com/api-keys) ---
OPENAI_API_KEY=sk-your-openai-key

# --- CORS (comma-separated browser origins allowed to call this API) ---
# Local development:
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Production example (uncomment and set your deployed frontend URL):
# CORS_ORIGINS=https://fluently.yourdomain.com
